rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function validTask(d) {
      return d.userId == request.auth.uid
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.description is string && d.description.size() <= 1000
        && d.subject is string && d.subject.size() <= 60
        && d.category is string
        && d.dueDate is timestamp
        && d.isCompleted is bool;
    }

    // Each student can only access their own tasks.
    match /tasks/{taskId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validTask(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validTask(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Profile document (name, email, push-notification tokens).
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
