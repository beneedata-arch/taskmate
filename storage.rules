rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Attachments live at attachments/{userId}/{taskId}/{fileName}.
    // Only the owner can read/write them; max 5 MB; limited file types.
    match /attachments/{userId}/{taskId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches(
             'image/(jpeg|png)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
